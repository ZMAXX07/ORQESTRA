# Backend Environment Configuration
ENVIRONMENT=development
APP_NAME=Orqestra API
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Explicit CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Supabase Platform Configuration (Phase 7.3)
# Project URL: https://<project-ref>.supabase.co
# Keys must be configured locally in .env and never committed to source control.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Supabase JWT Algorithm: "auto" (default, supports both HS256 and ES256), "HS256", or "ES256"
SUPABASE_JWT_ALGORITHM=auto

# AI Provider Configuration (Phase 5 & Phase 10.4: Google Gemini / OpenAI)
# Supported providers: "gemini" (recommended), "openai", "openai-compatible"
AI_PROVIDER=gemini
# Configure GEMINI_API_KEY (or AI_API_KEY) with your Google AI Studio API key
GEMINI_API_KEY=
AI_API_KEY=
# Model: "gemini-3.5-flash-lite" (default for gemini), "gemini-flash-latest", or "gpt-4o-mini"
AI_MODEL=gemini-3.5-flash-lite
# Base URL: Auto-defaults to "https://generativelanguage.googleapis.com/v1beta/openai" for gemini
# Only specify if using a custom gateway or proxy:
AI_BASE_URL=
AI_MAX_MESSAGE_LENGTH=4000
AI_REQUEST_TIMEOUT_SECONDS=15.0
AI_RATE_LIMIT_REQUESTS=15
AI_RATE_LIMIT_WINDOW_SECONDS=60

